# ── Secrets ────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ── Rust ───────────────────────────────────────────────────────────────
target/
**/*.rs.bk
*.pdb

# ── Go ─────────────────────────────────────────────────────────────────
/bin/
*.test
*.out

# ── Node / Next.js ─────────────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/
models/

# ── Artifacts (build output, not source) ───────────────────────────────
/dist/
/out/
/artifacts/
*.plt
*.dxf
*.hpgl
manifest.json
!docs/**/manifest.json

# ── Generated SVG previews (canonical masks live in fixtures) ──────────

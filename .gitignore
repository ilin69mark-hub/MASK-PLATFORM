# ── OS / editors ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
*.swp
# ── Spike (throwaway experiments, kept as ADR evidence) ───────────────
spike/**/target/

# ── Engine build output ───────────────────────────────────────────────
engine/target/
engine/out/

# ── Generated masks (produced by `make demo`) ─────────────────────
engine/out/

# ── WASM build output (regenerate with `make wasm-dist`) ───────────
engine/wasm/pkg/
engine/wasm/pkg-node/
